<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Muralis</RootNamespace>
    <AssemblyName>Muralis</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\muralis.ico</ApplicationIcon>
    <Version>1.2.2</Version>
    <Product>Muralis</Product>
    <!-- Publish single-file : embarque aussi les DLL natives (wpfgfx, D3DCompiler…)
         dans l'exe, sinon elles restent posées à côté. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Localisation : anglais = langue neutre (Strings.resx), français en satellite
         (Strings.fr.resx). Accessor régénéré par tools/gen-strings.ps1. -->
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône embarquée en ressource WPF : fenêtre (Icon) et tray (IconSource) via URI pack.
         ApplicationIcon ci-dessus ne couvre que l'icône Win32 de l'exe. -->
    <Resource Include="Assets\muralis.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
