<Page
    x:Class="Muralis.Views.Pages.WallpapersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Muralis.ViewModels"
    xmlns:res="clr-namespace:Muralis.Resources">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Rectangle du sélecteur d'écrans : proportionnel à la géométrie réelle du moniteur,
             miniature du fond appliqué en fond, numéro au centre, bordure accent si sélectionné
             (pattern Paramètres > Système > Affichage, cf. DESIGN.md). -->
        <Style x:Key="ScreenRectItem" TargetType="ListBoxItem">
            <Setter Property="Canvas.Left" Value="{Binding SelectorLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding SelectorTop}" />
            <Setter Property="ToolTip" Value="{Binding ResolutionLabel}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Rect"
                            Width="{Binding SelectorWidth}"
                            Height="{Binding SelectorHeight}"
                            Margin="2"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Border Margin="1" CornerRadius="3">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding CurrentWallpaper}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border
                                    Padding="8,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlSolidFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <TextBlock Style="{DynamicResource BodyStrongTextBlockStyle}" Text="{Binding Number}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rect" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Rect" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Rect" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Éditeur d'une cible (un écran, ou tous les écrans en mode unifié), en cards. -->
        <DataTemplate x:Key="ScreenEditor" DataType="{x:Type vm:ScreenSettingsViewModel}">
            <StackPanel>
                <TextBlock
                    Margin="0,24,0,8"
                    Style="{DynamicResource BodyStrongTextBlockStyle}"
                    Text="{x:Static res:Strings.Wallpapers_SectionSource}" />

                <!-- Image fixe : toujours en place, grisée quand le diaporama prend la main
                     (pas de saut de layout, exclusivité explicite — issue #5) -->
                <ui:CardControl Margin="0,0,0,4" IsEnabled="{Binding ShowFixed}">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B9;" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_ImageTitle}" />
                            <TextBlock
                                Style="{DynamicResource CaptionTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding FixedSourceDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox
                            MinWidth="180"
                            ItemsSource="{Binding FixedSourceOptions}"
                            SelectedItem="{Binding SelectedFixedSource}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Common_Browse}"
                            Command="{Binding BrowseCommand}"
                            Visibility="{Binding IsLocalFile, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ui:CardControl>

                <!-- Diaporama : toggle dans le header, sous-réglages dépliés (DESIGN.md — cards) -->
                <ui:CardExpander Margin="0,0,0,4" IsExpanded="{Binding IsSlideshow, Mode=OneWay}">
                    <ui:CardExpander.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE786;" />
                    </ui:CardExpander.Icon>
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_SlideshowTitle}" />
                                <TextBlock
                                    Style="{DynamicResource CaptionTextBlockStyle}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{x:Static res:Strings.Wallpapers_SlideshowDesc}" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                Margin="8,0"
                                IsChecked="{Binding IsSlideshow}" />
                        </Grid>
                    </ui:CardExpander.Header>

                    <!-- Visibilité liée au toggle : le CardExpander remplace le binding OneWay
                         d'IsExpanded par une valeur locale au premier clic manuel sur le header,
                         le repli automatique ne suffit donc pas. -->
                    <StackPanel Visibility="{Binding ShowSlideshow, Converter={StaticResource BoolToVis}}">
                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_ImageSourceTitle}" />
                                    <TextBlock
                                        Style="{DynamicResource CaptionTextBlockStyle}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static res:Strings.Wallpapers_ImageSourceDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox
                                MinWidth="240"
                                ItemsSource="{Binding SourceOptions}"
                                SelectedItem="{Binding SelectedSource}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4" Visibility="{Binding IsLocalSource, Converter={StaticResource BoolToVis}}">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_FolderTitle}" />
                                    <TextBlock
                                        Style="{DynamicResource CaptionTextBlockStyle}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding FolderPath, TargetNullValue={x:Static res:Strings.Wallpapers_NoFolderSelected}}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseFolderCommand}" />
                        </ui:CardControl>

                        <!-- Grille de miniatures du dossier : coins 4px, espacement 8px,
                             ratio de l'écran préservé (DESIGN.md) -->
                        <ItemsControl
                            Margin="4,4,4,0"
                            ItemsSource="{Binding PreviewThumbnails}"
                            Visibility="{Binding ShowSlideshowPreview, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="{Binding DataContext.ThumbnailCellWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Height="{Binding DataContext.ThumbnailCellHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Margin="0,0,8,8"
                                        CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_IntervalTitle}" />
                                    <TextBlock
                                        Style="{DynamicResource CaptionTextBlockStyle}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static res:Strings.Wallpapers_IntervalDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:NumberBox
                                    Width="110"
                                    Minimum="1"
                                    Maximum="86400"
                                    ClearButtonEnabled="False"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding IntervalValue}" />
                                <ComboBox
                                    Width="120"
                                    Margin="8,0,0,0"
                                    ItemsSource="{Binding IntervalUnits}"
                                    SelectedItem="{Binding IntervalUnit}" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Visibility="{Binding IsLocalSource, Converter={StaticResource BoolToVis}}">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B1;" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_ShuffleTitle}" />
                                    <TextBlock
                                        Style="{DynamicResource CaptionTextBlockStyle}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{x:Static res:Strings.Wallpapers_ShuffleDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding Shuffle}" />
                        </ui:CardControl>
                    </StackPanel>
                </ui:CardExpander>

                <TextBlock
                    Margin="0,24,0,8"
                    Style="{DynamicResource BodyStrongTextBlockStyle}"
                    Text="{x:Static res:Strings.Wallpapers_SectionDisplay}" />

                <ui:CardControl>
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_DisplayModeTitle}" />
                            <TextBlock
                                Style="{DynamicResource CaptionTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static res:Strings.Wallpapers_DisplayModeDesc}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox
                        MinWidth="160"
                        ItemsSource="{Binding AvailableModes}"
                        SelectedItem="{Binding SelectedMode}" />
                </ui:CardControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- Le scroll est assuré par le présentateur du NavigationView ; la barre « Appliquer »
         vit dans la fenêtre pour rester toujours visible.
         Marges de page 36/24, contenu plafonné à 1000px (DESIGN.md — Espacements). -->
    <StackPanel MaxWidth="1000" Margin="36,24">
                <TextBlock
                    Margin="0,0,0,24"
                    Style="{DynamicResource TitleTextBlockStyle}"
                    Text="{x:Static res:Strings.Wallpapers_Title}" />

                <ui:CardControl>
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Wallpapers_UnifiedTitle}" />
                            <TextBlock
                                Style="{DynamicResource CaptionTextBlockStyle}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{x:Static res:Strings.Wallpapers_UnifiedDesc}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding UnifiedMode}" />
                </ui:CardControl>

                <!-- Sélecteur d'écrans : disposition réelle des moniteurs (mode séparé) -->
                <StackPanel Margin="0,24,0,0" Visibility="{Binding ShowPerScreen, Converter={StaticResource BoolToVis}}">
                    <ListBox
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ItemContainerStyle="{StaticResource ScreenRectItem}"
                        ItemsSource="{Binding Screens}"
                        SelectedItem="{Binding SelectedScreen}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding SelectorCanvasWidth}" Height="{Binding SelectorCanvasHeight}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <!-- Résolution sous le sélecteur (DESIGN.md — pas dans un onglet) -->
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"><Run Text="{Binding SelectedScreen.DisplayLabel, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding SelectedScreen.ResolutionLabel, Mode=OneWay}" /></TextBlock>
                </StackPanel>

                <!-- Éditeur : écran sélectionné (mode séparé) ou cible unique (mode unifié) -->
                <ContentControl
                    Content="{Binding SelectedScreen}"
                    ContentTemplate="{StaticResource ScreenEditor}"
                    Visibility="{Binding ShowPerScreen, Converter={StaticResource BoolToVis}}" />
                <ContentControl
                    Content="{Binding UnifiedScreen}"
                    ContentTemplate="{StaticResource ScreenEditor}"
                    Visibility="{Binding ShowUnified, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</Page>

