<Page
    x:Class="Muralis.Views.Pages.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:Muralis.Resources"
    Loaded="OnLoaded">

    <!-- Le scroll est assuré par le présentateur du NavigationView.
         Marges de page 36/24, contenu plafonné à 1000px (DESIGN.md — Espacements). -->
    <StackPanel MaxWidth="1000" Margin="36,24">
        <TextBlock
            Margin="0,0,0,24"
            Style="{DynamicResource TitleTextBlockStyle}"
            Text="{x:Static res:Strings.Settings_Title}" />

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Settings_StartupTitle}" />
                    <TextBlock
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Settings_StartupDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding AppSettings.StartWithWindows}" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE775;" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Settings_LanguageTitle}" />
                    <TextBlock
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Settings_LanguageDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemsSource="{Binding AppSettings.LanguageOptions}"
                SelectedItem="{Binding AppSettings.SelectedLanguage}" />
        </ui:CardControl>

        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Settings_ThemeTitle}" />
                    <TextBlock
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Settings_ThemeDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="200"
                ItemsSource="{Binding AppSettings.ThemeOptions}"
                SelectedItem="{Binding AppSettings.SelectedTheme}" />
        </ui:CardControl>

        <TextBlock
            Margin="0,24,0,8"
            Style="{DynamicResource BodyStrongTextBlockStyle}"
            Text="{x:Static res:Strings.Settings_SectionApiKeys}" />

        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D7;" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="Wallhaven" />
                    <TextBlock
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Settings_WallhavenKeyDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:PasswordBox
                Width="320"
                Password="{Binding AppSettings.WallhavenApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </ui:CardControl>
    </StackPanel>
</Page>
