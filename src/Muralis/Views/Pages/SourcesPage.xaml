<Page
    x:Class="Muralis.Views.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:Muralis.Resources">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <!-- Le scroll est assuré par le présentateur du NavigationView.
         Marges de page 36/24, contenu plafonné à 1000px (DESIGN.md — Espacements). -->
    <StackPanel MaxWidth="1000" Margin="36,24">
        <TextBlock
            Margin="0,0,0,24"
            Style="{DynamicResource TitleTextBlockStyle}"
            Text="{x:Static res:Strings.Sources_Title}" />

        <TextBlock
            Margin="0,0,0,8"
            Style="{DynamicResource BodyStrongTextBlockStyle}"
            Text="{x:Static res:Strings.Sources_SectionAdded}" />

        <!-- Une card par source : globe, nom, URL en ellipsis, Retirer dans le header ;
             dépliée, la card permet d'éditer la config (plusieurs presets invitent à ajuster
             les tags/paramètres directement dans l'URL). -->
        <ItemsControl ItemsSource="{Binding Sources.Sources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Margin="0,0,0,4">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{Binding Name}" />
                                    <TextBlock
                                        Style="{DynamicResource CaptionTextBlockStyle}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding RequestUrl}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0"
                                    Content="{x:Static res:Strings.Sources_Remove}"
                                    Command="{Binding DataContext.Sources.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <ui:TextBox
                                Margin="0,0,0,8"
                                PlaceholderText="{x:Static res:Strings.Sources_PlaceholderName}"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox
                                Margin="0,0,0,8"
                                PlaceholderText="{x:Static res:Strings.Sources_PlaceholderUrl}"
                                Text="{Binding RequestUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox
                                Margin="0,0,0,8"
                                PlaceholderText="{x:Static res:Strings.Sources_PlaceholderJsonPath}"
                                Text="{Binding ImageUrlJsonPath, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- En-tête/clé par instance : sources personnalisées uniquement —
                                 les presets connus partagent la clé de Paramètres > Clés API. -->
                            <Grid Margin="0,0,0,8" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    PlaceholderText="{x:Static res:Strings.Sources_PlaceholderHeader}"
                                    Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:PasswordBox
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    PlaceholderText="{x:Static res:Strings.Sources_PlaceholderKey}"
                                    Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    Content="{x:Static res:Strings.Sources_SaveChanges}"
                                    Command="{Binding DataContext.Sources.UpdateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Content="{x:Static res:Strings.Sources_Duplicate}"
                                    Command="{Binding DataContext.Sources.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- État vide -->
        <ui:Card Visibility="{Binding Sources.HasNoSources, Converter={StaticResource BoolToVis}}">
            <TextBlock
                Style="{DynamicResource CaptionTextBlockStyle}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static res:Strings.Sources_EmptyState}" />
        </ui:Card>

        <TextBlock
            Margin="0,24,0,8"
            Style="{DynamicResource BodyStrongTextBlockStyle}"
            Text="{x:Static res:Strings.Sources_SectionAdd}" />

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Sources_CatalogTitle}" />
                    <TextBlock
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Sources_CatalogDesc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="240"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Sources.AvailablePresets}"
                    SelectedItem="{Binding Sources.SelectedPreset}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Content="{x:Static res:Strings.Common_Add}"
                    Command="{Binding Sources.AddPresetCommand}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Aide du preset sélectionné -->
        <TextBlock
            Margin="4,4,4,8"
            Style="{DynamicResource CaptionTextBlockStyle}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="{Binding Sources.PresetNote}"
            Visibility="{Binding Sources.ShowPresetNote, Converter={StaticResource BoolToVis}}" />

        <!-- Formulaire replié par défaut (DESIGN.md — ne pas étaler les 5 champs) -->
        <ui:CardExpander Margin="0,0,0,4">
            <ui:CardExpander.Icon>
                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
            </ui:CardExpander.Icon>
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{DynamicResource BodyTextBlockStyle}" Text="{x:Static res:Strings.Sources_CustomTitle}" />
                    <TextBlock
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Sources_CustomDesc}" />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource CaptionTextBlockStyle}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static res:Strings.Sources_KindCaption}" />
                    <ComboBox
                        MinWidth="240"
                        ItemsSource="{Binding Sources.KindOptions}"
                        SelectedItem="{Binding Sources.SelectedKind}" />
                </StackPanel>
                <ui:TextBox
                    Margin="0,0,0,8"
                    PlaceholderText="{x:Static res:Strings.Sources_PlaceholderName}"
                    Text="{Binding Sources.CustomName, UpdateSourceTrigger=PropertyChanged}" />
                <ui:TextBox
                    Margin="0,0,0,8"
                    PlaceholderText="{x:Static res:Strings.Sources_PlaceholderUrl}"
                    Text="{Binding Sources.CustomUrl, UpdateSourceTrigger=PropertyChanged}" />
                <ui:TextBox
                    Margin="0,0,0,8"
                    PlaceholderText="{x:Static res:Strings.Sources_PlaceholderJsonPath}"
                    Text="{Binding Sources.CustomJsonPath, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        PlaceholderText="{x:Static res:Strings.Sources_PlaceholderHeader}"
                        Text="{Binding Sources.CustomApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:PasswordBox
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        PlaceholderText="{x:Static res:Strings.Sources_PlaceholderKey}"
                        Password="{Binding Sources.CustomApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <ui:Button
                    HorizontalAlignment="Left"
                    Content="{x:Static res:Strings.Sources_AddCustom}"
                    Command="{Binding Sources.AddCustomCommand}" />
            </StackPanel>
        </ui:CardExpander>

        <!-- Retour d'action (ajout/retrait/erreur de saisie) -->
        <TextBlock
            Margin="4,8,4,0"
            Style="{DynamicResource CaptionTextBlockStyle}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding Sources.StatusMessage}" />
    </StackPanel>
</Page>
