<ui:FluentWindow
    x:Class="Muralis.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:Muralis.Views.Pages"
    Title="Muralis"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="600"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Muralis" />

        <!-- Pane gauche fixe façon Paramètres Windows 11 (DESIGN.md — Navigation).
             Icônes Segoe Fluent : E7F4 TVMonitor, E774 Globe, E713 Settings. -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Fonds d'écran" TargetPageType="{x:Type pages:WallpapersPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Sources web" TargetPageType="{x:Type pages:SourcesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Paramètres" TargetPageType="{x:Type pages:AppSettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Barre d'action de la page Fonds d'écran : ancrée en bas de la fenêtre (hors du
             scroll de page géré par le NavigationView), séparateur supérieur (DESIGN.md — Boutons) -->
        <Border
            Grid.Row="2"
            Padding="36,10"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            Visibility="{Binding IsWallpapersPageActive, Converter={StaticResource BoolToVis}}">
            <Grid MaxWidth="1000">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}" />
                <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Content="Appliquer"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    Command="{Binding ApplyCommand}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
