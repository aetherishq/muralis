  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Muralis.Core\Muralis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
